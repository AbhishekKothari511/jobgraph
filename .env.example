# ─── Supabase / PostgreSQL ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Source Adapters ─────────────────────────────────────────────────────────
# Adzuna (free: https://developer.adzuna.com)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=gb                      # gb | us | au | ca | de | fr | in
ADZUNA_KEYWORD=software+engineer

# RSS Feed adapter
RSS_FEED_URL=https://remotive.com/remote-jobs/feed
RSS_FEED_NAME=remotive                 # arbitrary source name, used as idempotency prefix

# CSV drop folder adapter
CSV_DROP_FOLDER=./drop                 # relative to apps/ingestion/
CSV_ARCHIVE_FOLDER=./drop/archive      # processed files are moved here

# ─── LLM (Phase 4) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── Deduplication (Phase 3) ─────────────────────────────────────────────────
DEDUP_EMBEDDING_THRESHOLD=0.92        # cosine similarity ≥ this → near-duplicate

# ─── API (Phase 5) ───────────────────────────────────────────────────────────
PORT=3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Cache (Phase 6) ─────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ─── Worker (Phase 2) ────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
QUEUE_NAME=job-ingestion
DLQ_NAME=job-ingestion-dlq
MAX_RETRIES=3
